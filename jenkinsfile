pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t deployflow:${BUILD_NUMBER} .'
            }
        }

        stage('Import Image into Kubernetes') {
            steps {
                sh '''
                    docker save deployflow:${BUILD_NUMBER} -o /tmp/deployflow.tar
                    sudo /usr/local/bin/k3s ctr images import /tmp/deployflow.tar
                    rm -f /tmp/deployflow.tar
                '''
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    kubectl set image deployment/deployflow deployflow=deployflow:${BUILD_NUMBER}
                    kubectl rollout status deployment/deployflow --timeout=120s
                '''
            }
        }
    }

    post {
        success {
            echo 'DeployFlow deployed successfully!'
        }
        failure {
            echo 'Deployment failed. Check the build logs.'
        }
    }
}
