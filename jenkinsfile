pipeline {
    agent any

    environment {
        KUBECONFIG = '/var/lib/jenkins/.kube/config'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t deployflow:${BUILD_NUMBER} .'
            }
        }

        stage('Import Image into Kubernetes') {
            steps {
                sh '''
                    docker save deployflow:${BUILD_NUMBER} -o /tmp/deployflow.tar
                    sudo /usr/local/bin/ctr --address /run/k3s/containerd/containerd.sock --namespace k8s.io images import /tmp/deployflow.tar
                    rm -f /tmp/deployflow.tar
                '''
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    /usr/local/bin/kubectl set image deployment/deployflow deployflow=deployflow:${BUILD_NUMBER}
                    /usr/local/bin/kubectl rollout status deployment/deployflow --timeout=120s
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    /usr/local/bin/kubectl get deployment deployflow
                    /usr/local/bin/kubectl get pods -l app=deployflow
                '''
            }
        }
    }

    post {
        success {
            echo 'DeployFlow deployed successfully!'
        }
        failure {
            echo 'Deployment failed. Check the build logs.'
        }
    }
}
