pipeline {
 agent any
 environment {
  KUBECONFIG='/var/lib/jenkins/.kube/config'
  NAMESPACE='bluegreen'
  IMAGE_NAME='bluegreen-app'
  SERVICE_NAME='bg-production'
 }
 stages {
  stage('Checkout') { steps { checkout scm } }
  stage('Build Docker Image') {
   steps { sh 'docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} -f experiment-8/Dockerfile experiment-8' }
  }
  stage('Import Image into K3s') {
   steps { sh '''
    set -e
    docker save ${IMAGE_NAME}:${BUILD_NUMBER} -o /tmp/bg-${BUILD_NUMBER}.tar
    sudo /usr/local/bin/ctr --address /run/k3s/containerd/containerd.sock --namespace k8s.io images import /tmp/bg-${BUILD_NUMBER}.tar
    rm -f /tmp/bg-${BUILD_NUMBER}.tar
   ''' }
  }
  stage('Choose Inactive Environment') {
   steps { script {
    def active=sh(script:"kubectl get svc ${SERVICE_NAME} -n ${NAMESPACE} -o jsonpath='{.spec.selector.color}' 2>/dev/null || true",returnStdout:true).trim()
    env.TARGET_COLOR=(active=='blue')?'green':'blue'
    echo "Current active: ${active ?: 'none'}; target: ${env.TARGET_COLOR}"
   } }
  }
  stage('Deploy and Verify Inactive') {
   steps { sh '''
    set -e
    cat <<EOF | kubectl apply -n ${NAMESPACE} -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bg-${TARGET_COLOR}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: bluegreen
      color: ${TARGET_COLOR}
  template:
    metadata:
      labels:
        app: bluegreen
        color: ${TARGET_COLOR}
    spec:
      containers:
      - name: app
        image: ${IMAGE_NAME}:${BUILD_NUMBER}
        imagePullPolicy: Never
        ports:
        - containerPort: 8080
        env:
        - name: APP_COLOR
          value: "${TARGET_COLOR}"
        - name: APP_VERSION
          value: "${BUILD_NUMBER}"
        readinessProbe:
          httpGet:
            path: /health
            port: 8080
          initialDelaySeconds: 2
          periodSeconds: 3
        livenessProbe:
          httpGet:
            path: /health
            port: 8080
          initialDelaySeconds: 5
          periodSeconds: 10
EOF
    kubectl rollout status deployment/bg-${TARGET_COLOR} -n ${NAMESPACE} --timeout=120s
    READY=$(kubectl get pods -n ${NAMESPACE} -l app=bluegreen,color=${TARGET_COLOR} -o jsonpath='{.items[?(@.status.containerStatuses[0].ready==true)].metadata.name}' | wc -w)
    test "$READY" -ge 2
    echo "Health checks passed: $READY pods Ready."
   ''' }
  }
  stage('Switch Production Traffic') {
   steps { sh '''
    set -e
    if kubectl get svc ${SERVICE_NAME} -n ${NAMESPACE} >/dev/null 2>&1; then
      kubectl patch svc ${SERVICE_NAME} -n ${NAMESPACE} --type=merge -p '{"spec":{"selector":{"app":"bluegreen","color":"'"${TARGET_COLOR}"'"}}}'
    else
      cat <<EOF | kubectl apply -n ${NAMESPACE} -f -
apiVersion: v1
kind: Service
metadata:
  name: ${SERVICE_NAME}
spec:
  type: NodePort
  selector:
    app: bluegreen
    color: ${TARGET_COLOR}
  ports:
  - port: 80
    targetPort: 8080
    nodePort: 30081
EOF
    fi
    kubectl get svc ${SERVICE_NAME} -n ${NAMESPACE}
    kubectl get endpoints ${SERVICE_NAME} -n ${NAMESPACE}
   ''' }
  }
  stage('Final Status') {
   steps { sh '''
    kubectl get svc ${SERVICE_NAME} -n ${NAMESPACE} -o jsonpath='{.spec.selector.color}'; echo
    kubectl get deployments,pods,services -n ${NAMESPACE} -o wide
   ''' }
  }
 }
 post {
  success { echo "Blue-Green deployment successful. Active: ${env.TARGET_COLOR}" }
  failure { echo 'Deployment failed. Service traffic is switched only after readiness checks.' }
 }
}
